"""Tests for A2AExecutor."""

from __future__ import annotations

from typing import Any

import pytest
from a2a.server.events import EventQueue
from a2a.types.a2a_pb2 import TaskState
from a2a.utils.errors import UnsupportedOperationError

from {{ project.python_package }}.infrastructure.entry_points.a2a_server.agent_executor import A2AExecutor


class _FakeContext:
    """Minimal RequestContext stand-in; avoids a full A2A request flow."""

    def __init__(self, text: str, task_id: str = "t1", context_id: str = "c1") -> None:
        self._text = text
        self.task_id = task_id
        self.context_id = context_id
        self.current_task = None

    def get_user_input(self) -> str:
        return self._text


class _CollectingQueue(EventQueue):
    """EventQueue that records every event the executor publishes."""

    def __init__(self) -> None:
        self.events: list[Any] = []

    async def enqueue_event(self, event: Any) -> None:
        self.events.append(event)


async def _run_executor(ctx: _FakeContext) -> list[Any]:
    queue = _CollectingQueue()
    await A2AExecutor().execute(ctx, queue)  # type: ignore[arg-type]
    return queue.events


async def test_execute_produces_artifact_with_hello_world() -> None:
    events = await _run_executor(_FakeContext("hola"))
    artifact_events = [e for e in events if hasattr(e, "artifact")]
    assert artifact_events, "Expected at least one TaskArtifactUpdateEvent"
    text = "".join(p.text for p in artifact_events[0].artifact.parts if p.text)
    assert "Hello, World!" in text
    assert "hola" in text


async def test_execute_ends_with_completed_status() -> None:
    events = await _run_executor(_FakeContext("test"))
    states = [e.status.state for e in events if hasattr(e, "status")]
    assert states, "Expected a status event"
    assert states[-1] == TaskState.TASK_STATE_COMPLETED


async def test_execute_reports_failed_on_error(monkeypatch: pytest.MonkeyPatch) -> None:
    ctx = _FakeContext("boom")

    def _raise() -> str:
        raise RuntimeError("forced")

    monkeypatch.setattr(ctx, "get_user_input", _raise)
    events = await _run_executor(ctx)
    states = [e.status.state for e in events if hasattr(e, "status")]
    assert states, "Expected a status event"
    assert states[-1] == TaskState.TASK_STATE_FAILED


async def test_cancel_raises_unsupported() -> None:
    with pytest.raises(UnsupportedOperationError):
        await A2AExecutor().cancel(_FakeContext("x"), _CollectingQueue())  # type: ignore[arg-type]
