"""MCP composition root — creates the FastMCP instance and Starlette ASGI app."""

from __future__ import annotations

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

from mcp.server.fastmcp import FastMCP
from starlette.applications import Starlette
from starlette.routing import Mount
from wireup import inject_from_container

from {{ project.python_package }}.application.config.wiring import create_container
from {{ project.python_package }}.infrastructure.entry_points.mcp_server import routes, tools
{%- if with_resources %}
from {{ project.python_package }}.infrastructure.entry_points.mcp_server import resources
{%- endif %}
{%- if with_prompts %}
from {{ project.python_package }}.infrastructure.entry_points.mcp_server import prompts
{%- endif %}

# Module-level FastMCP instance; infrastructure routes (health check, etc.) are bound here.
mcp: FastMCP = FastMCP("{{ project.name }}", stateless_http=True)
routes.bind_routes(mcp)


@asynccontextmanager
async def lifespan(_app: Starlette) -> AsyncIterator[None]:
    """Warm up the wireup container, inject use cases into tools, then serve."""
    container = create_container()
    try:
        await inject_from_container(container)(tools.bind_tools)(mcp)
        {%- if with_resources %}
        await inject_from_container(container)(resources.bind_resources)(mcp)
        {%- endif %}
        {%- if with_prompts %}
        await inject_from_container(container)(prompts.bind_prompts)(mcp)
        {%- endif %}
        async with mcp.session_manager.run():
            yield
    finally:
        await container.close()


def start_server() -> Starlette:
    """Return a Starlette ASGI application wrapping the FastMCP instance."""
    return Starlette(
        routes=[Mount("/", app=mcp.streamable_http_app())],
        lifespan=lifespan,
    )
