"""Settings for the secrets adapter — loaded from environment."""

from __future__ import annotations

from pydantic_settings import BaseSettings, SettingsConfigDict


class SecretsSettings(BaseSettings):
    """Environment-sourced settings for the secrets adapter.

    All fields are required (no defaults) so a missing env var fails at startup.
    """

    provider: str

    model_config = SettingsConfigDict(
        env_prefix="SECRETS_",
        env_file=".env",
        env_file_encoding="utf-8",
    )
