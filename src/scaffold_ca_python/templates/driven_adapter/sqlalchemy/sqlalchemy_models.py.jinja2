"""SQLAlchemy declarative base and ORM models."""

from __future__ import annotations

from sqlalchemy.orm import DeclarativeBase


class Base(DeclarativeBase):
    """Shared declarative base for all ORM models in this adapter.

    Pass ``Base.metadata`` to Alembic env.py or use
    ``await conn.run_sync(Base.metadata.create_all)`` in tests.
    """


