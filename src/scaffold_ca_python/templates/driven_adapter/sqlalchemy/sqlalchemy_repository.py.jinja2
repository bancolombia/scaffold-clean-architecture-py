@wireup.injectable
class SQLAlchemyRepository:
    """Async SQLAlchemy driven adapter.

    Uses a session factory from DI (see sqlalchemy_config).
    Use @wireup.injectable(as_type=<GatewayABC>) when implementing a domain gateway.
    """
{% endif %}
    def __init__(self, sessions: async_sessionmaker[AsyncSession]) -> None:
        self._sessions = sessions

    async def ping(self) -> bool:
        """Lightweight DB connectivity check (SELECT 1)."""
        async with self._sessions() as session:
            await session.execute(text("SELECT 1"))
        return True

