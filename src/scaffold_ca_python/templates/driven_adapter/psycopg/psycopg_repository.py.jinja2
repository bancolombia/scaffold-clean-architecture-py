@wireup.injectable
class PsycopgRepository:
    """Async psycopg driven adapter.

    Uses the shared connection pool from DI (see psycopg_config).
    Use @wireup.injectable(as_type=<GatewayABC>) when implementing a domain gateway.
    """
{% endif %}
    def __init__(self, pool: PsycopgConnectionPool) -> None:
        self._pool = pool

    async def ping(self) -> bool:
        """Lightweight DB connectivity check (SELECT 1)."""
        async with self._pool.connection() as conn, conn.cursor() as cur:
            await cur.execute("SELECT 1")
            return await cur.fetchone() == (1,)

