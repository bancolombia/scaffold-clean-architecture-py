{% else %}
@wireup.injectable
class RestConsumerAdapter:
    """Async REST consumer adapter.

    Wraps a shared :class:`httpx.AsyncClient` (provided via DI) for a thin, testable HTTP boundary.
    Replace the placeholder methods with your actual API calls.
    Use @wireup.injectable(as_type=<GatewayABC>) when this adapter implements a domain gateway.
    """
{% endif %}
    def __init__(self, client: httpx.AsyncClient) -> None:
        self._client = client

    async def get(
        self,
        path: str,
        *,
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
    ) -> httpx.Response:
        """Perform an async GET request."""
        return await self._client.get(path, params=params, headers=headers)

    async def post(
        self,
        path: str,
        *,
        json: object | None = None,
        headers: dict[str, str] | None = None,
    ) -> httpx.Response:
        """Perform an async POST request."""
        return await self._client.post(path, json=json, headers=headers)
