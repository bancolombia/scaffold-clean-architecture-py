{% else %}
@wireup.injectable
class RestConsumerAdapter:
    """Async REST consumer adapter.

    Wraps a shared :class:`httpx.AsyncClient` (provided via DI) for a thin, testable HTTP boundary.
    Replace the placeholder methods with your actual API calls.
    Use @wireup.injectable(as_type=<GatewayABC>) when this adapter implements a domain gateway.
    """
{% endif %}
    def __init__(self, settings: RestConsumerSettings) -> None:
        self._settings = settings

    async def get(self, path: str, **kwargs: object) -> httpx.Response:
        """Perform an async GET request."""
        async with httpx.AsyncClient(base_url=self._settings.base_url) as client:
            return await client.get(path, **kwargs)

    async def post(self, path: str, **kwargs: object) -> httpx.Response:
        """Perform an async POST request."""
        async with httpx.AsyncClient(base_url=self._settings.base_url) as client:
            return await client.post(path, **kwargs)
