"""Async resource factory for the {{ class_name }} REST consumer httpx client (D6)."""

from __future__ import annotations

from collections.abc import AsyncIterator

import httpx
import wireup

from {{ project.python_package }}.infrastructure.driven_adapters.rest_consumer.rest_consumer_settings import (
    RestConsumerSettings,
)


@wireup.injectable
async def {{ module_name }}_client_factory(settings: RestConsumerSettings) -> AsyncIterator[httpx.AsyncClient]:
    """Create and yield a shared AsyncClient; closed when the container shuts down."""
    async with httpx.AsyncClient(base_url=settings.base_url) as client:
        yield client
