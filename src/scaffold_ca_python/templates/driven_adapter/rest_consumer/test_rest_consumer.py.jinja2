"""Tests for RestConsumerAdapter."""

from __future__ import annotations

import httpx
import pytest
import respx

from {{ project.python_package }}.infrastructure.driven_adapters.rest_consumer.rest_consumer import (
    RestConsumerAdapter,
)


@pytest.fixture()
def adapter() -> RestConsumerAdapter:
    client = httpx.AsyncClient(base_url="https://example.com")
    return RestConsumerAdapter(client)


@respx.mock
@pytest.mark.asyncio
async def test_get_returns_response(adapter: RestConsumerAdapter) -> None:
    respx.get("https://example.com/ping").mock(return_value=httpx.Response(200))
    response = await adapter.get("/ping")
    assert response.status_code == 200


@respx.mock
@pytest.mark.asyncio
async def test_post_returns_response(adapter: RestConsumerAdapter) -> None:
    respx.post("https://example.com/items").mock(return_value=httpx.Response(201))
    response = await adapter.post("/items", json={"name": "test"})
    assert response.status_code == 201
